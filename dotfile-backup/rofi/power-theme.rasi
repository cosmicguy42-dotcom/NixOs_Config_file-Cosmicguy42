* {
    /* Thème extrait de la screenshot */
    bg: #16171c;          /* Fond sombre */
    bg-alt: #1e1f28;      /* Surface secondaire */
    fg: #ced1fe;          /* Texte clair lavande */
    accent: #8d83b7;      /* Barre de sélection lavande/violet */
    border-col: #3f3e52;  /* Bordure subtile */

    background-color: transparent;
    text-color: @fg;
    font: "Iosevka Nerd Font 12";
}

window {
    background-color: @bg;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 0px; /* Sharp, square corners */
    width: 250px;
    padding: 15px;
    location: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt ];
    background-color: @bg-alt;
    padding: 10px;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 0px;
}

prompt {
    text-color: @accent;
    font: "Iosevka Nerd Font Bold 12";
}

listview {
    lines: 5;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    border-radius: 0px;
}

element normal normal {
    text-color: @fg;
}

element selected normal {
    background-color: @accent;
    text-color: #040614;
    border: 0px;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
    cursor: inherit;
}
