* {
    /* Black & White Palette */
    bg: #000000;          /* Pure Black */
    bg-alt: #151515;      /* Dark Gray for subtle surface separation */
    fg: #ffffff;          /* Pure White */
    accent: #ffffff;      /* White Borders & Highlights */
    
    background-color: transparent;
    text-color: @fg;
    font: "monospace 12";
}

window {
    background-color: @bg;
    border: 1px solid;
    border-color: @accent;
    border-radius: 0px; /* Sharp, square corners */
    width: 250px;
    padding: 15px;
    location: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 15px;
}

inputbar {
    children: [ prompt ];
    background-color: @bg-alt;
    padding: 10px;
    border: 1px solid;
    border-color: @accent;
    border-radius: 0px; 
}

prompt {
    text-color: @accent;
    font: "monospace bold 12";
}

listview {
    lines: 5;
    spacing: 8px;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 0px; 
}

element normal normal {
    text-color: @fg;
}

element selected normal {
    background-color: @accent;
    text-color: @bg;
    border: 1px solid;
    border-color: @accent;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
    cursor: inherit;
}

