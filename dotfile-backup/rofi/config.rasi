/**
 * Minimalist Rofi Configuration
 * Thème : Lavender / Dark (inspiré de la capture d'écran)
 **/

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "アプリ";
    display-run:                "逃げろ";
    display-filebrowser:        "ファイル";
    display-window:             "ディスプレイ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "Iosevka Nerd Font 12";
    icon-theme:                 "Papirus";
    disable-history:            false;
    click-to-exit:              true;
    drun-use-desktop-cache:     true;
}

/* ===================================================================
 * Variables de Couleurs & Ricing
 * =================================================================== */
* {
    /* Couleurs extraites de la screenshot */
    bg:                         #16171c;
    bg-alt:                     #1e1f28;
    surface:                    rgba(22, 23, 28, 0.95);
    fg:                         #ced1fe;
    fg-muted:                   #6e6c87;
    accent:                     #8d83b7;
    accent-hover:               #8d83b7;
    border-col:                 #3f3e52;

    /* Rétro-compatibilité / alias */
    foreground:                 @fg;
    border-color:               @border-col;

    /* Typographie & défauts */
    font:                       "Iosevka Nerd Font 12";
    background-color:           transparent;
    text-color:                 @fg;
}

/* ===================================================================
 * Fenêtre
 * =================================================================== */
window {
/*    transparency:               "real"; */
    location:                   center;
    anchor:                     center;
    width:                      520px;
    x-offset:                   0px;
    y-offset:                   0px;
    enabled:                    true;
    border:                     1px solid;
    border-color:               @border-color;
    border-radius:              0px;
    background-color:           @bg;
    cursor:                     "default";
}

/* ===================================================================
 * Conteneur principal
 * =================================================================== */
mainbox {
    enabled:                    true;
    spacing:                    8px;
    padding:                    12px;
    orientation:                vertical;
    children:                   [ "inputbar", "listview" ];
}

/* ===================================================================
 * Barre d'entrée / Recherche
 * =================================================================== */
inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    8px 12px;
    border-radius:              0px;
    background-color:           @bg-alt;
    border:                     1px solid;
    border-color:               @border-col;
    text-color:                 @fg;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @accent;
    font:                       "Iosevka Nerd Font Bold 12";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "Search";
    placeholder-color:          @fg-muted;
}

/* ===================================================================
 * Liste des résultats
 * =================================================================== */
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    2px;
    padding:                    4px 0px 0px 0px;
    background-color:           transparent;
}

/* ===================================================================
 * Éléments individuels
 * =================================================================== */
element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    7px 12px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
    orientation:                horizontal;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element selected.normal {
    background-color:           @accent;
    text-color:                 #040614;
    border:                     0px;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element-icon {
    background-color:           transparent;
    size:                       24px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

/* ===================================================================
 * Messages d'erreur
 * =================================================================== */
error-message {
    padding:                    15px;
    border-radius:              0px;
    background-color:           @bg;
    text-color:                 @fg;
}
