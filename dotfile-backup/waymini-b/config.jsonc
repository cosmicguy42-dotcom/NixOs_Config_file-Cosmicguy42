{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 8,

    "modules-left": [
        "niri/workspaces",
        "hyprland/workspaces",
        "mpris"
    ],

    "modules-center": ["clock"],

    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "network",
        "battery",
        "pulseaudio",
        "custom/power"
    ],

    "tray": {
        "spacing": 10,
        "icon-size": 20
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 150,
        "separate-outputs": true
    },

    "clock": {
        "locale": "en_US.UTF-8",
        "format": "{:%Y-%m-%d %H:%M:%S}",
        //"tooltip-format": "<tt>{calendar}</tt>",
        "tooltip-format": "<tt><span font='Iosevka Nerd Font' size='13pt'><b>{calendar}</b></span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                //"months": "<span color='#b59aeb'><b>{}</b></span>",
                "months": "<span color='#5f8787'><b>{}</b></span>", 
                "days": "<span color='#cdd6f4'>{}</span>",
                "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
                "today": "<span color='#f9e2af'><b><u>{}</u></b></span>"
            }
        },
        "interval": 1
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 2,
        "format": "MEM {percentage}%",
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },

    "backlight": {
        "format": "BRT {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "AC {capacity}%",
        "tooltip-format": "{timeTo} · {power}W"
    },

    "network": {
        "format-ethernet": "NET",
        "format-wifi": "NET {signalStrength}%",
        "format-disconnected": "NET --",
        "tooltip-format": "Network Information\n\nSSID: {essid}\nIP: {ipaddr}\nBand: {frequency} MHz\nSignal: {signalStrength}%   \nvia: {ifname}",
        "tooltip-format-disconnected": "no connection"
  },
  "mpris": {
        "format": "<span size='large'>{player_icon}</span> {dynamic}",
        "format-paused": "<span size='large'>{status_icon}</span> <i>{dynamic}</i>",
        "max-length": 50,
        "interval": 0.5,
        "player-icons": {
          "default": "▶",
          "spotify": "",
          "termusic": "󰝚 ",
          "mpv": "󰝚 "
        },
        "status-icons": {
            "paused": "⏸"
        },
        "ignored-players": ["vlc"] 
    },


    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "scroll-step": 5,
        "tooltip-format": "{desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/power": {
      "format": "POW",
      "tooltip": false,
      "on-click": "~/.config/rofi/powermenu.sh"
    }

}
