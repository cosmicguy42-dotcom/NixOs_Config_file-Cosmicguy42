configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    display-drun:               "";
    drun-display-format:        "{name}";
    disable-history:            false;
}

* {
    bg:             rgba(22, 27, 34, 0.82);
    surface:        rgba(45, 55, 72, 0.55);
    selected-bg:    rgba(153, 204, 250, 0.22);
    fg:             #e0e2e8;
    fg-alt:         #9bb0c6;
    accent:         #99ccfa;
    border-col:     #99ccfa;
    font:           "JetBrainsMono Nerd Font 11";
}

window {
    transparency:       "real";
    background-color:   @bg;
    text-color:         @fg;
    border:             1px solid;
    border-color:       @border-col;
    border-radius:      10px;
    width:              480px;
    location:           center;
    anchor:             center;
    x-offset:           0px;
    y-offset:           0px;
    padding:            0px;
}

mainbox {
    background-color:   transparent;
    orientation:        vertical;
    children:           [ "inputbar", "listview" ];
    spacing:            0px;
    padding:            14px;
}

inputbar {
    background-color:   @surface;
    text-color:         @fg;
    border-radius:      8px;
    padding:            10px 14px;
    spacing:            10px;
    orientation:        horizontal;
    children:           [ "prompt", "entry" ];
    margin:             0px 0px 10px 0px;
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    font:               "JetBrainsMono Nerd Font 12";
}

entry {
    background-color:   transparent;
    text-color:         @fg;
    placeholder:        "Rechercher une application...";
    placeholder-color:  @fg-alt;
    cursor:             text;
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              7;
    spacing:            4px;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    reverse:            false;
    fixed-height:       true;
}

element {
    background-color:   transparent;
    text-color:         @fg;
    border-radius:      6px;
    padding:            8px 12px;
    spacing:            12px;
    cursor:             pointer;
    orientation:        horizontal;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @fg;
}

element normal.active {
    background-color:   transparent;
    text-color:         @accent;
}

element selected.normal {
    background-color:   @selected-bg;
    text-color:         @accent;
}

element selected.active {
    background-color:   @selected-bg;
    text-color:         @accent;
}

element-icon {
    background-color:   transparent;
    size:               24px;
    cursor:             inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}
