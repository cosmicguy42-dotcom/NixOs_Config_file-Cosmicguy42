# Swaylock-effects Minimalist Monochrome Configuration

# Screenshot & Blur Effects
screenshots
effect-blur=10x5
effect-vignette=0.5:0.5
fade-in=0.2

# Clock
clock
timestr=%H:%M
datestr=%A %d %B %Y

# General
ignore-empty-password
font=JetBrainsMono Nerd Font

# Indicator
indicator
indicator-radius=90
indicator-thickness=6
indicator-caps-lock
line-uses-inside

# Monochrome Theme Colors
inside-color=181818cc
inside-clear-color=181818cc
inside-caps-lock-color=181818cc
inside-ver-color=181818cc
inside-wrong-color=262626cc

ring-color=333333ff
ring-clear-color=888888ff
ring-caps-lock-color=ffffffff
ring-ver-color=ffffffff
ring-wrong-color=555555ff

key-hl-color=ffffffff
bs-hl-color=aaaaaaff
separator-color=00000000

text-color=ffffffff
text-clear-color=ffffffff
text-caps-lock-color=ffffffff
text-ver-color=ffffffff
text-wrong-color=aaaaaaff
